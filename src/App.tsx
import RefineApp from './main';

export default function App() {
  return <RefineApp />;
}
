* {
  box-sizing: border-box;
}

:root {
  font-family: Inter, 'Segoe UI', sans-serif;
  line-height: 1.5;
  color: #103056;
  background: #edf2f6;
  font-weight: 400;
  color-scheme: light;
}

html, body, #root {
  min-height: 100%;
  height: 100%;
  margin: 0;
}

body {
  background: #eef2f5;
}

button, input, textarea, select {
  font: inherit;
}

.app-shell {
  display: flex;
  min-height: 100vh;
  background: #eef3f7;
}

.sidebar {
  width: 260px;
  background: #0f2342;
  color: #f4f8ff;
  padding: 18px 12px;
}

.brand-box {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 10px 18px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  margin-bottom: 16px;
}

.brand-mark {
  width: 42px;
  height: 42px;
  border-radius: 10px;
  background: #7c1d2a;
  color: white;
  display: grid;
  place-items: center;
  font-weight: 700;
}

.brand-box strong {
  display: block;
  font-size: 1rem;
}

.brand-box small {
  color: #c9d1df;
}

.side-nav {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.nav-item {
  color: #dfe7f3;
  text-decoration: none;
  padding: 10px 12px;
  border-radius: 8px;
  font-size: 0.96rem;
}

.nav-item:hover,
.nav-item.active {
  background: rgba(255, 255, 255, 0.08);
  color: #fff;
}

.main-panel {
  flex: 1;
  padding: 22px;
}

.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff;
  border-radius: 14px;
  border: 1px solid #dce5ee;
  padding: 18px 20px;
  margin-bottom: 22px;
  box-shadow: 0 8px 24px rgba(17, 44, 82, 0.04);
}

.topbar h1 {
  margin: 4px 0 0;
  font-size: clamp(1.1rem, 2vw, 1.75rem);
  letter-spacing: 0.02em;
  color: #112c55;
}

.eyebrow {
  margin: 0;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  font-size: 0.7rem;
  color: #7c1d2a;
  font-weight: 700;
}

.status-pill {
  background: #eaf4ef;
  color: #1a6b47;
  border-radius: 999px;
  padding: 8px 12px;
  font-size: 0.82rem;
  font-weight: 700;
}

.page-shell {
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8px;
}

.section-header h2 {
  margin: 4px 0 0;
  color: #142d52;
}

.primary-button {
  border: none;
  background: #7c1d2a;
  color: white;
  border-radius: 10px;
  padding: 10px 14px;
  font-weight: 600;
  cursor: pointer;
}

.card {
  background: #fff;
  border-radius: 14px;
  border: 1px solid #dfe7f0;
  padding: 18px;
  box-shadow: 0 8px 24px rgba(17, 44, 82, 0.04);
}

.alert-box {
  border-left: 5px solid #d85c5c;
}

.notice,
.list-plain {
  color: #2c425d;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 14px;
}

.small-grid {
  grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
}

.stat-card {
  background: linear-gradient(180deg, #ffffff, #f5f8fc);
  border: 1px solid #dfe7f0;
  border-radius: 12px;
  padding: 14px 16px;
}

.stat-card .label {
  font-size: 0.78rem;
  color: #52667d;
  margin-bottom: 8px;
}

.stat-card .value {
  font-size: clamp(1.2rem, 2vw, 1.8rem);
  color: #102d52;
  font-weight: 700;
}

.two-col-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 18px;
}

.panel-box h3 {
  margin-top: 0;
}

.empty-state {
  padding: 32px;
  text-align: center;
  color: #6f7e90;
  font-weight: 600;
}

.table-wrap {
  overflow-x: auto;
}

table {
  width: 100%;
  border-collapse: collapse;
  margin-top: 14px;
}

th, td {
  text-align: left;
  padding: 12px 10px;
  border-bottom: 1px solid #edf1f6;
}

th {
  font-size: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: #6a7d96;
}

.steps-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
  gap: 12px;
  margin: 18px 0;
}

.step-box {
  background: #f6f9fd;
  border: 1px solid #dfe7f0;
  border-radius: 10px;
  padding: 14px;
  font-weight: 600;
  color: #183154;
}

@media (max-width: 900px) {
  .app-shell {
    flex-direction: column;
  }

  .sidebar {
    width: 100%;
  }

  .side-nav {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
  }

  .topbar {
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }
}
